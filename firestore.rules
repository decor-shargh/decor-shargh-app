rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveRole(roleName) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active == true
        && userProfile().role == roleName;
    }

    function isAdmin() {
      return isActiveRole("admin");
    }

    function isSiteSupervisor() {
      return isActiveRole("siteSupervisor");
    }

    match /users/{userId} {
      // هر کاربر فقط پروفایل خودش را می‌بیند؛ ادمین همه کاربران را می‌بیند.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      // ثبت نام جدید: فقط ساخت پروفایل شخصی با نقش pending و دسترسی غیرفعال.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "pending"
        && request.resource.data.active == false
        && request.resource.data.email == request.auth.token.email;

      // نقش، فعال‌سازی و مسدودسازی فقط توسط ادمین تغییر می‌کند.
      allow update, delete: if isAdmin();
    }

    match /contracts/{contractId} {
      // Admin و سرپرست اجرای فعال قراردادها را می‌بینند.
      allow read: if isAdmin() || isSiteSupervisor();

      // ساخت و حذف قرارداد فقط برای Admin است.
      allow create, delete: if isAdmin();

      // Admin ویرایش کامل دارد. سرپرست اجرا فقط فیلدهای مربوط به پیشرفت و
      // تکمیل خودکار قرارداد را می‌تواند تغییر دهد؛ ساختار فعالیت‌ها دست‌نخورده می‌ماند.
      allow update: if isAdmin() || (
        isSiteSupervisor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'progressByActivity',
          'status',
          'completedAt',
          'updatedAt',
          'updatedBy',
          'appVersion'
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.progressByActivity is map
        && (request.resource.data.status == resource.data.status || request.resource.data.status in ['active', 'completed'])
      );

      match /history/{historyId} {
        // تاریخچه فقط در صورت درخواست خوانده می‌شود و برای Admin/سرپرست اجرا قابل مشاهده است.
        allow read: if isAdmin() || isSiteSupervisor();

        // رکورد تاریخچه فقط توسط همان کاربر فعال ایجاد می‌شود و immutable است.
        allow create: if (isAdmin() || isSiteSupervisor())
          && request.resource.data.contractId == contractId
          && request.resource.data.changedByUid == request.auth.uid;

        allow update, delete: if isAdmin();
      }
    }

    // سایر اطلاعات کاری همچنان فقط برای Admin فعال قابل دسترسی است.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

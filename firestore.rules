rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{userId} {
      // هر کاربر فقط پروفایل خودش را می‌بیند؛ ادمین همه کاربران را می‌بیند.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      // ثبت نام جدید: فقط ساخت پروفایل شخصی با نقش pending و دسترسی غیرفعال.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "pending"
        && request.resource.data.active == false
        && request.resource.data.email == request.auth.token.email;

      // نقش، فعال‌سازی و مسدودسازی فقط توسط ادمین تغییر می‌کند.
      allow update, delete: if isAdmin();
    }

    // اطلاعات کاری اپ فقط برای Admin فعال این نسخه قابل دسترسی است.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveRole(roleName) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active == true
        && (!userProfile().keys().hasAny(['blocked']) || userProfile().blocked != true)
        && userProfile().role == roleName;
    }

    function isAdmin() {
      return isActiveRole("admin");
    }

    function isSiteSupervisor() {
      return isActiveRole("siteSupervisor");
    }

    function isProjectManager() {
      return isActiveRole("projectManager");
    }

    function isActiveAppUser() {
      return isAdmin() || isSiteSupervisor() || isProjectManager();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "pending"
        && request.resource.data.active == false
        && request.resource.data.email == request.auth.token.email;

      // Admin manages access. Every active user can only update their own presence fields.
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastActiveAt',
          'lastSeenAt',
          'presenceState',
          'presenceUpdatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    match /contracts/{contractId} {
      allow read: if isAdmin() || isSiteSupervisor() || isProjectManager();
      allow create, delete: if isAdmin();

      // Admin has full edit access. Site supervisor may only update execution progress
      // and the denormalized open-issue summary shown on contract cards.
      allow update: if isAdmin() || (
        isSiteSupervisor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'progressByActivity',
          'status',
          'completedAt',
          'statusReason',
          'statusDate',
          'openIssueCount',
          'latestOpenIssue',
          'updatedAt',
          'updatedBy',
          'appVersion'
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['progressByActivity']) || request.resource.data.progressByActivity is map)
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status in ['pendingStart', 'inProgress', 'stopped', 'terminated']
          || (request.resource.data.status == 'completed' && request.resource.data.diff(resource.data).affectedKeys().hasAny(['progressByActivity']))
        )
      ) || (
        isProjectManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'openIssueCount',
          'latestOpenIssue',
          'updatedAt',
          'updatedBy',
          'appVersion'
        ])
        && request.resource.data.updatedBy == request.auth.uid
      );

      match /history/{historyId} {
        allow read: if isAdmin() || isSiteSupervisor();
        allow create: if (isAdmin() || isSiteSupervisor())
          && request.resource.data.contractId == contractId
          && request.resource.data.changedByUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /issues/{issueId} {
        allow read: if isAdmin() || isSiteSupervisor() || isProjectManager();

        allow create: if (isAdmin() || isSiteSupervisor())
          && request.resource.data.contractId == contractId
          && request.resource.data.createdByUid == request.auth.uid;

        // Supervisor can edit/complete only issues created by them. Admin can manage all.
        allow update: if isAdmin() || (
          isSiteSupervisor()
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.contractId == resource.data.contractId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text',
            'status',
            'completedAt',
            'updatedAt',
            'updatedAtClient'
          ])
        ) || (
          isProjectManager()
          && resource.data.status != 'done'
          && request.resource.data.status == 'done'
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.contractId == resource.data.contractId
          && request.resource.data.text == resource.data.text
          && request.resource.data.managerActionByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'completedAt',
            'updatedAt',
            'updatedAtClient',
            'managerNote',
            'managerActionByUid',
            'managerActionByName',
            'managerActionByEmail',
            'managerActionAt',
            'managerActionAtClient'
          ])
        );

        allow delete: if isAdmin() || (
          isSiteSupervisor()
          && resource.data.createdByUid == request.auth.uid
        );
      }
    }

    // Immutable audit log. It can be read by Admin, but nobody can edit or delete it.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isActiveAppUser()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /activityCategories/{docId} {
      allow read, write: if isAdmin();
    }

    match /activityLibrary/{docId} {
      allow read, write: if isAdmin();
    }

    match /appMeta/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
